# ===========================================
# ApplyTrak environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.
# ===========================================

# --- Database ---
# Connection string format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:dev@localhost:5432/applytrak

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ANTHROPIC_MODEL_PARSE=claude-haiku-4-5
ANTHROPIC_MODEL_SCORE=claude-sonnet-4-6

# --- Embeddings (Voyage AI) ---
# Added in Phase 3. Leave blank for now.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3

# --- LangSmith (tracing) ---
# Added in Phase 2. Leave blank for now.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=applytrak

# --- Telegram (digest delivery) ---
# Added in Phase 6. Leave blank for now.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Behavior knobs ---
RELEVANCE_THRESHOLD=0.65
DIGEST_MAX_ITEMS=10
DEDUPE_SIMILARITY_THRESHOLD=0.92
FETCH_INTERVAL_HOURS=4

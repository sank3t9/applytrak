# ===========================================
# ApplyTrak environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.
# ===========================================

# --- Database ---
# Connection string format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:dev@localhost:5432/applytrak

# --- Redis (optional) ---
# Leave EMPTY to run without Redis: the parse cache moves to a Postgres table
# and the rate limiter becomes in-process. That's what the deployed demo does.
REDIS_URL=redis://localhost:6379/0

# --- LLM provider ---
# Which provider handles parse / score / resume-extraction calls.
#   anthropic → Claude (paid, best quality; used for local runs and evals)
#   gemini    → Gemini free tier (no card; used for the public demo)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ANTHROPIC_MODEL_PARSE=claude-haiku-4-5
ANTHROPIC_MODEL_SCORE=claude-sonnet-4-6
ANTHROPIC_RPM=30

# Free key (no card): https://aistudio.google.com/app/apikey
# Model availability differs per key — Google retires older names for new keys.
# List what yours can use:
#   uv run python -c "from applytrak.llm.providers import get_gemini_client
#   [print(m.name) for m in get_gemini_client().models.list()]"
GEMINI_API_KEY=
GEMINI_MODEL_PARSE=gemini-3.5-flash-lite
GEMINI_MODEL_SCORE=gemini-3.5-flash
# Free-tier limits at time of writing (all share 1,500 requests/day):
#   Flash-Lite  30 RPM     Flash  15 RPM
# Keep these just under the published RPM so retries have room.
GEMINI_RPM_PARSE=25
GEMINI_RPM_SCORE=12
# low | high | off — "off" omits the setting for models that reject it.
GEMINI_THINKING_LEVEL=low

# --- Embeddings ---
# voyage or gemini. Both produce 1024-dim vectors.
#
# IMPORTANT: one database, one embedding model. Vectors from different models
# are not comparable, so dedup and matching only ever compare vectors carrying
# the active model's tag. Switching this value is safe but triggers a re-embed:
# run_embed picks up rows whose tag is stale, so the corpus heals over the next
# few pipeline runs (matches are just thinner until it finishes).
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- LangSmith (tracing, Anthropic path only) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=applytrak

# --- Telegram (personal digest delivery; unused by the public demo) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Behavior knobs ---
RELEVANCE_THRESHOLD=0.65
DIGEST_MAX_ITEMS=10
DEDUPE_SIMILARITY_THRESHOLD=0.92
FETCH_INTERVAL_HOURS=4

# Set to false during dev to disable the auto-pipeline (saves API credits).
# Must be false on serverless hosts — no long-lived process exists to run it.
RUN_SCHEDULER=true

# Set to false to hide the /run/* pipeline triggers. Required on any public
# deployment, otherwise visitors can spend your API quota.
EXPOSE_ADMIN_ENDPOINTS=true

# How long parse cache entries live (longer = better re-parse savings).
PARSE_CACHE_TTL_DAYS=30

# --- Public demo match flow ---
DEMO_RESUME_MAX_CHARS=15000
MATCH_TOP_K=15
MATCH_RECENT_DAYS=45
